// pnpm env:example — regenerates .env.example from lib/env/index.ts (the single list of variables).
import { execFileSync } from "node:child_process";
import { writeFile } from "node:fs/promises";

import { ENV_VARS, PLACEHOLDER } from "../lib/env/index.ts";

export function renderEnvExample(): string {
  const lines = [
    "# Environment variables for this storefront. Generated by `pnpm env:example` from lib/env/index.ts.",
    "# Copy to .env.local for local development. In Vercel, set them under Project → Settings → Environment Variables.",
    "# Plain-language guide: docs/04-environment-variables.md",
    "# VERCEL_ENV and VERCEL_PROJECT_PRODUCTION_URL are set by Vercel automatically; never set them yourself.",
  ];
  let group = "";
  for (const spec of ENV_VARS) {
    if (spec.group !== group) {
      group = spec.group;
      lines.push("", `# ── ${group} ${"─".repeat(Math.max(3, 70 - group.length))}`);
    }
    const need =
      spec.required === "always"
        ? "Required"
        : spec.required === "customerAccounts"
          ? "Required when features.customerAccounts is true"
          : "Optional";
    lines.push(
      `# ${spec.purpose}`,
      `# ${need} · ${spec.secret ? "Secret" : "Public"} · Where: ${spec.where}`,
      // Optional variables stay commented out: an empty string would override upstream defaults.
      spec.required === "always" ? `${spec.name}="${PLACEHOLDER}"` : `# ${spec.name}=""`,
    );
  }
  return `${lines.join("\n")}\n`;
}

export function renderEnvDoc(): string {
  const cell = (text: string) => text.replaceAll("|", "\\|");
  const lines = [
    "# 4. Environment variables",
    "",
    "<!-- Generated by `pnpm env:example` from lib/env/index.ts. Edit that file, not this one. -->",
    "",
    "Environment variables are settings the site needs but that must not live in the code: passwords, tokens and",
    "addresses that differ between stores. You set them in two places:",
    "",
    "- **On Vercel** (the live site and previews): Vercel → your project → **Settings → Environment Variables**.",
    "  Each variable can apply to **Production** (the live site), **Preview** (the test links on pull requests) and",
    "  **Development** (`vercel env pull` for local work). The table says which ones to tick.",
    "- **On your computer** (only if you run the site locally): in a file called `.env.local`. Copy `.env.example` to",
    "  `.env.local` and replace each `__REPLACE_ME__`.",
    "",
    "**Secret** values are passwords: never paste them into chat, issues or code. **Public** values end up in the",
    "browser and are safe to share. After changing a variable on Vercel, redeploy for it to take effect.",
    "",
    "Check what is set with `pnpm env:check` (✅ set, ➖ optional and empty, ❌ missing or wrong).",
    "If required values are missing, `pnpm dev` shows a setup page listing them, and Vercel builds stop with the same list.",
  ];
  let group = "";
  for (const spec of ENV_VARS) {
    if (spec.group !== group) {
      group = spec.group;
      lines.push(
        "",
        `## ${group}`,
        "",
        "| Variable | What it's for | Where to get it | Needed? | Type | Vercel environments |",
        "| --- | --- | --- | --- | --- | --- |",
      );
    }
    const need =
      spec.required === "always"
        ? "**Required**"
        : spec.required === "customerAccounts"
          ? "Required if customer accounts are on"
          : "Optional";
    const where = spec.docs ? `${spec.where} ([guide](${spec.docs}))` : spec.where;
    const vercel = spec.vercel.length > 0 ? spec.vercel.join(", ") : "Don't set on Vercel";
    lines.push(
      `| \`${spec.name}\` | ${cell(spec.purpose)} | ${cell(where)} | ${need} | ${spec.secret ? "Secret" : "Public"} | ${vercel} |`,
    );
  }
  lines.push(
    "",
    "## Set by Vercel automatically",
    "",
    "`VERCEL_ENV` (production, preview or development) and `VERCEL_PROJECT_PRODUCTION_URL` come from Vercel. Never set",
    "them yourself. Marketing tracking (Meta Pixel, GA4) only loads when `VERCEL_ENV` is `production`.",
  );
  return `${lines.join("\n")}\n`;
}

if (import.meta.main) {
  await writeFile(".env.example", renderEnvExample());
  await writeFile("docs/04-environment-variables.md", renderEnvDoc());
  execFileSync("pnpm", ["exec", "oxfmt", "docs/04-environment-variables.md"], { stdio: "ignore" });
  console.log("Wrote .env.example and docs/04-environment-variables.md");
}
