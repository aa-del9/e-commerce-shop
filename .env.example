# Environment variables for this storefront. Generated by `pnpm env:example` from lib/env/index.ts.
# Copy to .env.local for local development. In Vercel, set them under Project → Settings → Environment Variables.
# Plain-language guide: docs/04-environment-variables.md
# VERCEL_ENV and VERCEL_PROJECT_PRODUCTION_URL are set by Vercel automatically; never set them yourself.

# ── Site ──────────────────────────────────────────────────────────────────
# Public address of the store, used for canonical links, sitemap and webhook URLs.
# Optional · Public · Where: Your domain in Vercel → Project → Domains. Leave empty to use the Vercel production domain.
# NEXT_PUBLIC_SITE_URL=""

# ── Shopify Storefront ────────────────────────────────────────────────────
# Which Shopify store the site reads products, cart and checkout from.
# Required · Public · Where: Shopify admin → Settings → Domains: the your-store.myshopify.com address.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="__REPLACE_ME__"
# Public token that lets the site read the catalog and manage carts.
# Required · Public · Where: Shopify admin → Sales channels → Headless → your storefront → Storefront API → Public access token.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="__REPLACE_ME__"
# Numeric shop ID used by Shopify analytics and checkout.
# Required · Public · Where: Set the store domain and token first, then run `pnpm env:check`: it looks the number up and prints it.
NEXT_PUBLIC_SHOPIFY_SHOP_ID="__REPLACE_ME__"
# Headless storefront ID for analytics attribution.
# Optional · Public · Where: Shopify admin → Sales channels → Headless → your storefront (number in the URL).
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID=""
# Overrides the Storefront API version. Leave empty.
# Optional · Public · Where: Only set when a developer asks you to.
# SHOPIFY_API_VERSION=""

# ── Shopify webhooks & revalidation ───────────────────────────────────────
# Lets the site trust Shopify's change notifications, so edits show up within seconds.
# Optional · Secret · Where: The client secret of the app that ran `pnpm shopify:setup` (Dev Dashboard → app → Settings).
# SHOPIFY_WEBHOOK_SECRET=""
# Password for refreshing content Shopify sends no notification for (menus, pages, policies).
# Optional · Secret · Where: Make one up: a long random string (for example from a password manager).
# REVALIDATE_SECRET=""

# ── Customer accounts ─────────────────────────────────────────────────────
# Encrypts customer login sessions. Only needed when customer accounts are on.
# Required when features.customerAccounts is true · Secret · Where: Make one up: a long random string. It is not a Shopify value.
# CUSTOMER_ACCOUNT_SESSION_SECRET=""
# Identifies the store to Shopify's customer login.
# Required when features.customerAccounts is true · Secret · Where: Shopify admin → Sales channels → Headless → your storefront → Customer Account API.
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
# Secret for Shopify's customer login.
# Required when features.customerAccounts is true · Secret · Where: Same screen as the client ID.
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_SECRET=""

# ── Shopify Admin (setup script only) ─────────────────────────────────────
# Store the setup script changes. Defaults to NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN.
# Optional · Public · Where: your-store.myshopify.com. Only in .env.local on the computer that runs setup.
# SHOPIFY_STORE_DOMAIN=""
# Admin API token for `pnpm shopify:setup`. Never needed by the live site.
# Optional · Secret · Where: See docs/03-setting-up-a-new-store.md → Admin API access. Or use the client ID and secret below.
# SHOPIFY_ADMIN_API_ACCESS_TOKEN=""
# Dev Dashboard app client ID; setup exchanges it for a 24-hour Admin token.
# Optional · Public · Where: Shopify Dev Dashboard → your app → Settings.
# SHOPIFY_ADMIN_CLIENT_ID=""
# Dev Dashboard app client secret (pairs with the client ID).
# Optional · Secret · Where: Shopify Dev Dashboard → your app → Settings.
# SHOPIFY_ADMIN_CLIENT_SECRET=""
# Admin API version the setup script uses (default 2026-10).
# Optional · Public · Where: Leave empty unless a developer asks you to change it.
# SHOPIFY_ADMIN_API_VERSION=""

# ── Analytics ─────────────────────────────────────────────────────────────
# Meta (Facebook/Instagram) Pixel for ads measurement. Loads only on the live site.
# Optional · Public · Where: Meta Events Manager → Data sources → your Pixel → ID.
# NEXT_PUBLIC_META_PIXEL_ID=""
# Google Analytics 4 measurement. Loads only on the live site.
# Optional · Public · Where: Google Analytics → Admin → Data streams → your web stream → Measurement ID.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
# Set to "true" to test Pixel/GA4 outside production. Never set it in Production.
# Optional · Public · Where: Only for testing tracking locally or on one preview.
# ANALYTICS_FORCE_ENABLE=""
# Reserved for a future server-side Meta Conversions API. Not read yet; leave empty.
# Optional · Secret · Where: See docs/maintainers/roadmap.md.
# META_CAPI_ACCESS_TOKEN=""

# ── Agent & bot protection (dormant) ──────────────────────────────────────
# Model access for the Shop Agent (features.agent). Off by default.
# Optional · Secret · Where: Vercel → AI Gateway. Only when a developer turns the agent on.
# AI_GATEWAY_API_KEY=""
# Override for the Shop Agent's public profile. Leave empty.
# Optional · Public · Where: Only when a developer turns the agent on.
# UCP_AGENT_PROFILE_URL=""
# Set automatically by the agent's dev command. Leave empty.
# Optional · Public · Where: Never set by hand.
# EVE_DEV=""

# ── Debugging ─────────────────────────────────────────────────────────────
# Set to "1" to log how long each Shopify request takes.
# Optional · Public · Where: Only while a developer investigates slowness.
# DEBUG_SHOPIFY=""
